<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>F1 Grand Prix Racer</title>

<style>
* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    font-family: Arial, sans-serif;
    touch-action: none;
}

#game {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 100vh;
    margin: auto;
    overflow: hidden;
}

canvas {
    width: 100%;
    height: 100%;
    display: block;
}

#hud {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 52px;
    background: rgba(0,0,0,.8);
    color: white;
    display: flex;
    justify-content: space-around;
    align-items: center;
    font-size: 12px;
    font-weight: bold;
    z-index: 5;
}

.screen {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.88);
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: white;
    z-index: 20;
}

.hidden {
    display: none;
}

.panel h1 {
    color: #ff2020;
    font-size: 38px;
    text-shadow: 0 0 20px red;
}

button {
    border: 0;
    border-radius: 14px;
    padding: 16px 30px;
    background: #e60000;
    color: white;
    font-size: 18px;
    font-weight: bold;
}

#wheel {
    position: absolute;
    left: 15px;
    bottom: 25px;
    width: 105px;
    height: 105px;
    border: 12px solid #111;
    border-radius: 50%;
    background: #444;
    box-shadow: 0 0 0 3px #aaa;
    z-index: 10;
}

#wheel::before {
    content: "";
    position: absolute;
    width: 70px;
    height: 8px;
    background: #111;
    left: 5px;
    top: 36px;
}

#wheel::after {
    content: "";
    position: absolute;
    width: 8px;
    height: 70px;
    background: #111;
    left: 36px;
    top: 5px;
}

#pedals {
    position: absolute;
    right: 10px;
    bottom: 28px;
    display: flex;
    gap: 8px;
    z-index: 10;
}

.pedal {
    width: 68px;
    height: 68px;
    border-radius: 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 10px;
    font-weight: bold;
    border: 2px solid white;
}

#accelerator {
    background: #008c38;
}

#brake {
    background: #c40000;
}
</style>
</head>

<body>

<div id="game">

<canvas id="canvas"></canvas>

<div id="hud">
    <span id="score">SCORE: 0</span>
    <span id="coinText">🪙 0</span>
    <span id="gear">GEAR: P</span>
    <span id="speed">0 KM/H</span>
</div>

<div id="startScreen" class="screen">
    <div class="panel">
        <h1>F1 GRAND PRIX</h1>
        <p>🏎️ Dodge colourful traffic</p>
        <p>🪙 Collect giant coins</p>
        <p>⚙️ Automatic gearbox</p>
        <button id="startBtn">START RACE</button>
    </div>
</div>

<div id="gameOverScreen" class="screen hidden">
    <div class="panel">
        <h1>CRASH!</h1>
        <p id="finalResult"></p>
        <button id="restartBtn">RACE AGAIN</button>
    </div>
</div>

<div id="wheel"></div>

<div id="pedals">
    <div id="brake" class="pedal">BRAKE</div>
    <div id="accelerator" class="pedal">ACCEL</div>
</div>

</div>

<script>

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

const startScreen =
    document.getElementById("startScreen");

const gameOverScreen =
    document.getElementById("gameOverScreen");

const startBtn =
    document.getElementById("startBtn");

const restartBtn =
    document.getElementById("restartBtn");

const scoreElement =
    document.getElementById("score");

const coinElement =
    document.getElementById("coinText");

const gearElement =
    document.getElementById("gear");

const speedElement =
    document.getElementById("speed");

const finalResult =
    document.getElementById("finalResult");

const wheel =
    document.getElementById("wheel");

const accelerator =
    document.getElementById("accelerator");

const brake =
    document.getElementById("brake");


/* =========================
   CANVAS
========================= */

let W = 450;
let H = 800;

function resizeCanvas() {

    const rect =
        canvas.getBoundingClientRect();

    W = rect.width;
    H = rect.height;

    const dpr =
        Math.min(
            window.devicePixelRatio || 1,
            2
        );

    canvas.width = W * dpr;
    canvas.height = H * dpr;

    ctx.setTransform(
        dpr, 0, 0, dpr, 0, 0
    );
}

window.addEventListener(
    "resize",
    resizeCanvas
);

resizeCanvas();


/* =========================
   GAME VARIABLES
========================= */

let running = false;

let score = 0;
let coins = 0;
let distance = 0;

let roadOffset = 0;
let spawnTimer = 0;

let traffic = [];
let coinObjects = [];

let accelerating = false;
let braking = false;

let steering = 0;

let colourIndex = 0;


/* =========================
   PLAYER
========================= */

const player = {

    x: 200,
    y: 560,

    w: 44,
    h: 92,

    speed: 0,

    maxSpeed: 12
};


/* =========================
   ROAD
========================= */

function roadLeft() {
    return W * 0.13;
}

function roadRight() {
    return W * 0.87;
}

function roadWidth() {
    return roadRight() - roadLeft();
}

function getLanes() {

    return [

        roadLeft() + roadWidth() * 0.16,

        roadLeft() + roadWidth() * 0.39,

        roadLeft() + roadWidth() * 0.61,

        roadLeft() + roadWidth() * 0.84

    ];
}


/* =========================
   RESET
========================= */

function resetGame() {

    score = 0;
    coins = 0;
    distance = 0;

    roadOffset = 0;
    spawnTimer = 0;

    traffic = [];
    coinObjects = [];

    colourIndex = 0;

    player.x =
        W / 2 - player.w / 2;

    player.y =
        H - 220;

    player.speed = 0;

    steering = 0;

    wheel.style.transform =
        "rotate(0deg)";

    updateHUD();
}


/* =========================
   START
========================= */

function startGame() {

    resetGame();

    running = true;

    startScreen.classList.add(
        "hidden"
    );

    gameOverScreen.classList.add(
        "hidden"
    );
}

startBtn.onclick = startGame;
restartBtn.onclick = startGame;


/* =========================
   TOUCH BUTTONS
========================= */

function holdButton(
    element,
    callback
) {

    element.addEventListener(
        "touchstart",
        function(e) {

            e.preventDefault();

            callback(true);

        },
        { passive: false }
    );

    element.addEventListener(
        "touchend",
        function(e) {

            e.preventDefault();

            callback(false);

        },
        { passive: false }
    );

    element.addEventListener(
        "touchcancel",
        function(e) {

            e.preventDefault();

            callback(false);

        },
        { passive: false }
    );

    element.addEventListener(
        "mousedown",
        function() {
            callback(true);
        }
    );

    element.addEventListener(
        "mouseup",
        function() {
            callback(false);
        }
    );

    element.addEventListener(
        "mouseleave",
        function() {
            callback(false);
        }
    );
}

holdButton(
    accelerator,
    v => accelerating = v
);

holdButton(
    brake,
    v => braking = v
);


/* =========================
   STEERING
========================= */

let wheelTouching = false;
let wheelStartX = 0;

wheel.addEventListener(
    "touchstart",
    function(e) {

        e.preventDefault();

        wheelTouching = true;

        wheelStartX =
            e.touches[0].clientX;

    },
    { passive: false }
);

wheel.addEventListener(
    "touchmove",
    function(e) {

        e.preventDefault();

        if (!wheelTouching)
            return;

        const movement =
            e.touches[0].clientX -
            wheelStartX;

        steering = Math.max(
            -40,
            Math.min(40, movement)
        );

        wheel.style.transform =
            "rotate(" +
            steering +
            "deg)";

    },
    { passive: false }
);

function releaseWheel() {

    wheelTouching = false;

    steering *= 0.5;

    if (
        Math.abs(steering) < 1
    ) {
        steering = 0;
    }
}

wheel.addEventListener(
    "touchend",
    releaseWheel
);

wheel.addEventListener(
    "touchcancel",
    releaseWheel
);


/* =========================
   KEYBOARD
========================= */

window.addEventListener(
    "keydown",
    function(e) {

        if (e.key === "ArrowUp")
            accelerating = true;

        if (e.key === "ArrowDown")
            braking = true;

        if (e.key === "ArrowLeft")
            steering = -35;

        if (e.key === "ArrowRight")
            steering = 35;

        if (
            e.key === "Enter" &&
            !running
        ) {
            startGame();
        }
    }
);

window.addEventListener(
    "keyup",
    function(e) {

        if (e.key === "ArrowUp")
            accelerating = false;

        if (e.key === "ArrowDown")
            braking = false;

        if (
            e.key === "ArrowLeft" ||
            e.key === "ArrowRight"
        ) {
            steering = 0;
        }
    }
);


/* =========================
   AUTOMATIC GEARS
========================= */

function getGear() {

    if (player.speed < 0.1)
        return "P";

    if (player.speed < 1.5)
        return "1";

    if (player.speed < 3)
        return "2";

    if (player.speed < 4.5)
        return "3";

    if (player.speed < 6)
        return "4";

    if (player.speed < 7.5)
        return "5";

    if (player.speed < 9)
        return "6";

    if (player.speed < 10.5)
        return "7";

    return "8";
}


/* =========================
   UPDATE
========================= */

function update() {

    if (!running)
        return;


    /* Smooth acceleration */

    if (accelerating) {

        player.speed += 0.035;

        if (
            player.speed >
            player.maxSpeed
        ) {
            player.speed =
                player.maxSpeed;
        }

    } else if (braking) {

        player.speed -= 0.18;

        if (player.speed < 0)
            player.speed = 0;

    } else {

        player.speed -= 0.008;

        if (player.speed < 0)
            player.speed = 0;
    }


    /* Steering */

    player.x +=
        steering *
        (
            0.065 +
            player.speed * 0.006
        );


    /* Road boundaries */

    player.x =
        Math.max(
            roadLeft() + 20,
            Math.min(
                roadRight() -
                player.w -
                20,
                player.x
            )
        );


    roadOffset +=
        player.speed * 2.5;

    distance +=
        player.speed;

    score =
        Math.floor(distance / 5) +
        coins * 100;


    /* Traffic */

    spawnTimer++;

    /*
       Gradually increase traffic.
       Never more than 4 cars.
    */

    if (
        spawnTimer >= 55 &&
        traffic.length < 4
    ) {

        spawnTimer = 0;

        addTrafficCar();

        /*
           Sometimes create another car.
        */

        if (
            Math.random() < 0.50 &&
            traffic.length < 4
        ) {
            addTrafficCar();
        }

        /*
           Rarely create a third/fourth.
        */

        if (
            Math.random() < 0.20 &&
            traffic.length < 4
        ) {
            addTrafficCar();
        }

        if (
            Math.random() < 0.08 &&
            traffic.length < 4
        ) {
            addTrafficCar();
        }
    }


    updateTraffic();
    updateCoins();
    updateHUD();
}


/* =========================
   CAR COLOURS
========================= */

const carColours = [

    "#ff1744",
    "#00aaff",
    "#ffd600",
    "#00c853",
    "#aa00ff",
    "#ff6d00",
    "#00e5ff",
    "#ffffff"

];


/* =========================
   ADD TRAFFIC CAR
========================= */

function addTrafficCar() {

    if (traffic.length >= 4)
        return;


    const laneList =
        getLanes();

    let available = [];


    for (
        let i = 0;
        i < laneList.length;
        i++
    ) {

        const x =
            laneList[i] - 21;

        let safe = true;


        for (
            const car of traffic
        ) {

            /*
              Cars cannot spawn
              directly on another car.
            */

            if (
                Math.abs(car.x - x) < 20 &&
                Math.abs(car.y + 140) < 150
            ) {

                safe = false;

                break;
            }
        }


        if (safe)
            available.push(x);
    }


    if (available.length === 0)
        return;


    const x =
        available[
            Math.floor(
                Math.random() *
                available.length
            )
        ];


    /*
       Give cars different colours.
    */

    const colour =
        carColours[
            colourIndex %
            carColours.length
        ];

    colourIndex++;


    traffic.push({

        x: x,

        y:
            -120 -
            Math.random() * 150,

        w: 42,

        h: 80,

        speed:
            1 +
            Math.random() * 1.5,

        colour: colour
    });
}


/* =========================
   UPDATE TRAFFIC
========================= */

function updateTraffic() {

    for (
        let i = traffic.length - 1;
        i >= 0;
        i--
    ) {

        const car =
            traffic[i];


        car.y +=
            player.speed +
            car.speed;


        if (
            car.y > H + 100
        ) {

            traffic.splice(i, 1);

            continue;
        }


        if (
            rectangleCollision(
                player,
                car
            )
        ) {

            endGame();

            return;
        }
    }


    /*
       Keep traffic cars separated.
    */

    for (
        let i = 0;
        i < traffic.length;
        i++
    ) {

        for (
            let j = i + 1;
            j < traffic.length;
            j++
        ) {

            const a = traffic[i];
            const b = traffic[j];


            if (
                Math.abs(a.x - b.x) < 18 &&
                Math.abs(a.y - b.y) < 105
            ) {

                if (a.y < b.y) {

                    b.y =
                        a.y +
                        a.h +
                        25;

                } else {

                    a.y =
                        b.y +
                        b.h +
                        25;
                }
            }
        }
    }
}


/* =========================
   COINS
========================= */

function addCoin() {

    coinObjects.push({

        x:
            roadLeft() +
            35 +
            Math.random() *
            (roadWidth() - 70),

        y: -60,

        radius: 25,

        rotation: 0
    });
}


function updateCoins() {

    if (
        Math.random() < 0.018 &&
        coinObjects.length < 3
    ) {

        addCoin();
    }


    for (
        let i = coinObjects.length - 1;
        i >= 0;
        i--
    ) {

        const coin =
            coinObjects[i];


        coin.y +=
            player.speed;

        coin.rotation += 0.08;


        const dx =
            coin.x -
            (
                player.x +
                player.w / 2
            );

        const dy =
            coin.y -
            (
                player.y +
                player.h / 2
            );


        const d =
            Math.sqrt(
                dx * dx +
                dy * dy
            );


        if (d < 48) {

            coins++;

            coinObjects.splice(i, 1);

        } else if (
            coin.y > H + 80
        ) {

            coinObjects.splice(i, 1);
        }
    }
}


/* =========================
   COLLISION
========================= */

function rectangleCollision(a, b) {

    const p = 8;

    return (

        a.x + p <
        b.x + b.w - p &&

        a.x + a.w - p >
        b.x + p &&

        a.y + p <
        b.y + b.h - p &&

        a.y + a.h - p >
        b.y + p
    );
}


/* =========================
   GAME OVER
========================= */

function endGame() {

    running = false;

    finalResult.textContent =
        "Score: " +
        Math.floor(score) +
        "   |   🪙 Coins: " +
        coins;

    gameOverScreen.classList.remove(
        "hidden"
    );
}


/* =========================
   HUD
========================= */

function updateHUD() {

    scoreElement.textContent =
        "SCORE: " +
        Math.floor(score);

    coinElement.textContent =
        "🪙 " +
        coins;

    gearElement.textContent =
        "GEAR: " +
        getGear();

    speedElement.textContent =
        Math.floor(
            player.speed * 25
        ) +
        " KM/H";
}


/* =========================
   DRAW ROAD
========================= */

function drawRoad() {

    const L = roadLeft();
    const R = roadRight();


    /* Grass */

    ctx.fillStyle =
        "#287a2e";

    ctx.fillRect(
        0,
        0,
        W,
        H
    );


    /* Road */

    ctx.fillStyle =
        "#303030";

    ctx.fillRect(
        L,
        0,
        roadWidth(),
        H
    );


    /* Road edge */

    ctx.fillStyle =
        "#ffffff";

    ctx.fillRect(
        L,
        0,
        5,
        H
    );

    ctx.fillRect(
        R - 5,
        0,
        5,
        H
    );


    /* Red/white kerbs */

    const stripe = 40;

    for (
        let y =
            -stripe +
            roadOffset % stripe;

        y < H;

        y += stripe
    ) {

        const n =
            Math.floor(
                (y + roadOffset) /
                stripe
            );


        ctx.fillStyle =
            n % 2 === 0
            ? "#ffffff"
            : "#e60000";


        ctx.fillRect(
            L + 5,
            y,
            12,
            stripe
        );

        ctx.fillRect(
            R - 17,
            y,
            12,
            stripe
        );
    }


    /* Lane lines */

    ctx.strokeStyle =
        "#ffffff";

    ctx.lineWidth = 3;

    ctx.setLineDash(
        [30,30]
    );

    ctx.lineDashOffset =
        -roadOffset;


    const laneList =
        getLanes();


    for (
        let i = 0;
        i < 3;
        i++
    ) {

        const x =
            (
                laneList[i] +
                laneList[i + 1]
            ) / 2;


        ctx.beginPath();

        ctx.moveTo(
            x,
            0
        );

        ctx.lineTo(
            x,
            H
        );

        ctx.stroke();
    }


    ctx.setLineDash([]);
}


/* =========================
   DRAW COIN
========================= */

function drawCoin(c) {

    ctx.save();

    ctx.translate(
        c.x,
        c.y
    );


    const scale =
        Math.max(
            .25,
            Math.abs(
                Math.cos(
                    c.rotation
                )
            )
        );


    ctx.scale(
        scale,
        1
    );


    /* Glow */

    ctx.fillStyle =
        "rgba(255,215,0,.25)";

    ctx.beginPath();

    ctx.arc(
        0,
        0,
        42,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /* Outer coin */

    ctx.fillStyle =
        "#a96800";

    ctx.beginPath();

    ctx.arc(
        4,
        5,
        30,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /* Gold */

    const gold =
        ctx.createRadialGradient(
            -8,
            -10,
            2,
            0,
            0,
            30
        );


    gold.addColorStop(
        0,
        "#fffbd0"
    );

    gold.addColorStop(
        .3,
        "#fff06a"
    );

    gold.addColorStop(
        .65,
        "#ffd000"
    );

    gold.addColorStop(
        1,
        "#d88900"
    );


    ctx.fillStyle = gold;

    ctx.beginPath();

    ctx.arc(
        0,
        0,
        27,
        0,
        Math.PI * 2
    );

    ctx.fill();


    ctx.strokeStyle =
        "#fff5a0";

    ctx.lineWidth = 3;

    ctx.beginPath();

    ctx.arc(
        0,
        0,
        23,
        0,
        Math.PI * 2
    );

    ctx.stroke();


    ctx.fillStyle =
        "#9c5b00";

    ctx.font =
        "bold 30px Arial";

    ctx.textAlign =
        "center";

    ctx.textBaseline =
        "middle";

    ctx.fillText(
        "$",
        0,
        1
    );


    ctx.restore();
}


/* =========================
   TRAFFIC CAR
========================= */

function drawTrafficCar(car) {

    const x = car.x;
    const y = car.y;
    const w = car.w;
    const h = car.h;


    ctx.save();

    ctx.translate(
        x,
        y
    );


    /* Shadow */

    ctx.fillStyle =
        "rgba(0,0,0,.45)";

    ctx.fillRect(
        -4,
        5,
        w + 8,
        h
    );


    /* Wheels */

    ctx.fillStyle =
        "#050505";

    ctx.fillRect(
        -6,
        12,
        9,
        24
    );

    ctx.fillRect(
        w - 3,
        12,
        9,
        24
    );

    ctx.fillRect(
        -6,
        h - 36,
        9,
        24
    );

    ctx.fillRect(
        w - 3,
        h - 36,
        9,
        24
    );


    /* Body */

    ctx.fillStyle =
        car.colour;

    ctx.beginPath();

    ctx.roundRect(
        2,
        0,
        w - 4,
        h,
        9
    );

    ctx.fill();


    /* Roof */

    ctx.fillStyle =
        "#222";

    ctx.beginPath();

    ctx.moveTo(
        8,
        18
    );

    ctx.lineTo(
        w - 8,
        18
    );

    ctx.lineTo(
        w - 12,
        40
    );

    ctx.lineTo(
        12,
        40
    );

    ctx.closePath();

    ctx.fill();


    /* Windows */

    ctx.fillStyle =
        "#071820";

    ctx.fillRect(
        10,
        21,
        w - 20,
        16
    );


    /* Lights */

    ctx.fillStyle =
        "#ffffff";

    ctx.fillRect(
        7,
        5,
        8,
        5
    );

    ctx.fillRect(
        w - 15,
        5,
        8,
        5
    );


    ctx.fillStyle =
        "#ff0000";

    ctx.fillRect(
        7,
        h - 10,
        9,
        5
    );

    ctx.fillRect(
        w - 16,
        h - 10,
        9,
        5
    );


    ctx.restore();
}


/* =========================
   F1 CAR
========================= */

function drawF1(p) {

    const x = p.x;
    const y = p.y;
    const w = p.w;
    const h = p.h;


    ctx.save();

    ctx.translate(
        x,
        y
    );


    /* Shadow */

    ctx.fillStyle =
        "rgba(0,0,0,.5)";

    ctx.fillRect(
        -5,
        5,
        w + 10,
        h
    );


    /* Tires */

    ctx.fillStyle =
        "#050505";

    ctx.fillRect(
        -7,
        16,
        9,
        31
    );

    ctx.fillRect(
        w - 2,
        16,
        9,
        31
    );

    ctx.fillRect(
        -7,
        h - 45,
        9,
        30
    );

    ctx.fillRect(
        w - 2,
        h - 45,
        9,
        30
    );


    /* Front wing */

    ctx.fillStyle =
        "#111";

    ctx.fillRect(
        -10,
        2,
        w + 20,
        7
    );


    /* Body */

    ctx.fillStyle =
        "#e50914";

    ctx.beginPath();

    ctx.moveTo(
        w / 2,
        0
    );

    ctx.lineTo(
        w - 7,
        25
    );

    ctx.lineTo(
        w - 10,
        h - 18
    );

    ctx.lineTo(
        w / 2,
        h
    );

    ctx.lineTo(
        10,
        h - 18
    );

    ctx.lineTo(
        7,
        25
    );

    ctx.closePath();

    ctx.fill();


    /* Centre stripe */

    ctx.fillStyle =
        "rgba(255,255,255,.5)";

    ctx.fillRect(
        w / 2 - 2,
        10,
        4,
        35
    );


    /* Cockpit */

    ctx.fillStyle =
        "#050505";

    ctx.beginPath();

    ctx.ellipse(
        w / 2,
        45,
        9,
        19,
        0,
        0,
        Math.PI * 2
    );

    ctx.fill();


    /* Halo */

    ctx.strokeStyle =
        "#aaa";

    ctx.lineWidth = 3;

    ctx.beginPath();

    ctx.arc(
        w / 2,
        43,
        10,
        Math.PI,
        0
    );

    ctx.stroke();


    /* Rear wing */

    ctx.fillStyle =
        "#111";

    ctx.fillRect(
        -7,
        h - 10,
        w + 14,
        8
    );


    ctx.restore();
}


/* =========================
   GAME LOOP
========================= */

function gameLoop() {

    update();

    draw();

    requestAnimationFrame(
        gameLoop
    );
}


/* =========================
   MAIN DRAW
========================= */

function draw() {

    ctx.clearRect(
        0,
        0,
        W,
        H
    );

    drawRoad();


    for (
        const coin of coinObjects
    ) {
        drawCoin(coin);
    }


    for (
        const car of traffic
    ) {
        drawTrafficCar(car);
    }


    drawF1(player);
}


gameLoop();

</script>

